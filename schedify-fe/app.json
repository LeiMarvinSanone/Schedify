{
  "expo": {
    "name": "Schedify",
    "slug": "schedify-fe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "com.schedify.app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.schedify.app",
      "config": {
        "googleSignIn": {
          "reservedClientId": "117812296292-lcmgr0qak328sget4qf44sp7j2m9an5i.apps.googleusercontent.com"
        }
      }
    },
    "android": {
      "package": "com.schedify.app",
      "label": "Schedify",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "config": {
        "googleSignIn": {
          "certificateHash": "94:04:C6:DE:D0:2A:B4:E4:AC:8E:7A:9B:08:D2:D3:AE:6B:3E:8A:53"
        }
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f39023b4-a3f5-4362-9233-88948af5113a"
      }
    },
    "owner": "schedify-app"
  }
}
